# Copier vers .env, puis générer les secrets selon le README.
# .env est ignoré par Git et ne doit jamais être committé.

# Rallly — mot de passe conservé pour la compatibilité avec le volume existant.
# Pour une nouvelle base, utiliser une valeur hexadécimale (openssl rand -hex 32).
RALLLY_DATABASE_PASSWORD=postgres
RALLLY_SECRET=
RALLLY_BASE_URL=http://localhost:3000
RALLLY_SUPPORT_EMAIL=support@example.com

# Authentik — même version et mêmes secrets pour le serveur et le worker.
AUTHENTIK_TAG=2026.8.5
AUTHENTIK_HOST=authentik.localhost
AUTHENTIK_HTTP_PORT=9000
AUTHENTIK_HTTPS_PORT=9443
AUTHENTIK_DB_NAME=authentik
AUTHENTIK_DB_USER=authentik
AUTHENTIK_DB_PASSWORD=
AUTHENTIK_SECRET_KEY=
AUTHENTIK_BOOTSTRAP_EMAIL=admin@example.com

# OIDC — partagé entre Rallly et le blueprint Authentik.
# AUTHENTIK_HOST doit être accessible depuis le navigateur et le réseau Docker.
# RALLLY_BASE_URL doit correspondre à l'URL du navigateur, sans slash final.
EMAIL_LOGIN_ENABLED=false
OIDC_NAME=Authentik
OIDC_CLIENT_ID=rallly
OIDC_CLIENT_SECRET=
