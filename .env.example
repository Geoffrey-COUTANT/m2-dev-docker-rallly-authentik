# SQUELETTE — valeurs à confirmer avec les versions choisies.
# Ne pas utiliser tel quel pour un déploiement public.
# Copier vers .env uniquement en local et ne jamais committer .env.

# Nom DNS local ou public à définir à l'étape infrastructure
PROJECT_DOMAIN=localhost
ACME_EMAIL=admin@example.invalid

# Rallly — noms indicatifs ; vérifier les variables exigées par la version retenue
RALLLY_DATABASE_NAME=rallly
RALLLY_DATABASE_USER=rallly
RALLLY_DATABASE_PASSWORD=CHANGE_ME_LOCAL_ONLY
RALLLY_SECRET=CHANGE_ME_LOCAL_ONLY

# Authentik — les noms exacts seront validés selon la version retenue
AUTHENTIK_SECRET_KEY=CHANGE_ME_GENERATE_A_STRONG_SECRET
AUTHENTIK_POSTGRESQL__HOST=authentik-db
AUTHENTIK_POSTGRESQL__NAME=authentik
AUTHENTIK_POSTGRESQL__USER=authentik
AUTHENTIK_POSTGRESQL__PASSWORD=CHANGE_ME_LOCAL_ONLY

# Mot de passe de la base Authentik (si séparé du mot de passe ci-dessus)
AUTHENTIK_DB_PASSWORD=CHANGE_ME_LOCAL_ONLY

# SMTP de laboratoire — facultatif au début, nécessaire pour tester les invitations par e-mail
SMTP_HOST=
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=lab@example.invalid
